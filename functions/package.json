{
  "name": "verifix-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Verifix artisan marketplace",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outdir=lib --external:firebase-functions --external:firebase-admin --external:express --external:cors",
    "test": "jest",
    "test:rules": "firebase emulators:exec --project demo-verifix --only firestore \"jest --runInBand --runTestsByPath rules-tests/firestore.rules.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm test -- --runInBand",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.6.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "13.10.0",
    "firebase-functions": "^7.3.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/jest": "29.5.14",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.27.0",
    "firebase": "12.18.0",
    "jest": "29.7.0",
    "jest-util": "29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.3.0"
  },
  "private": true
}
