# Non-secret runtime configuration for local emulators only.
NODE_ENV=development
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
ALLOWED_ORIGINS=http://localhost:5173
ENABLE_API_DOCS=true
ENABLE_DEV_AUTH=false

# Do not place PAYSTACK_SECRET_KEY, ENCRYPTION_KEY, or ADMIN_UID in this file.
# Configure them with Firebase Secret Manager for deployed functions:
# firebase functions:secrets:set PAYSTACK_SECRET_KEY
# firebase functions:secrets:set ENCRYPTION_KEY
# firebase functions:secrets:set ADMIN_UID
