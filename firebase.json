{
  "functions": [
    {
      "source": "functions/lib",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix functions run build"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "/health",
        "function": "api"
      }
    ]
  },
  "firestore": {
    "database": "default",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": {
      "port": 5005
    },
    "firestore": {
      "port": 8085
    },
    "auth": {
      "port": 9095
    },
    "ui": {
      "enabled": true,
      "port": 4005
    }
  },
  "auth": {
    "authorizedDomains": [
      "localhost",
      "artiva-a0594.firebaseapp.com",
      "artiva-a0594.web.app"
    ],
    "providers": {
      "emailPassword": true
    }
  }
}
