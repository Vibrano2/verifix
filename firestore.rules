rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function job(jobId) {
      return get(/databases/$(database)/documents/jobs/$(jobId));
    }

    function selectedMatch(jobId) {
      return get(/databases/$(database)/documents/matches/$(job(jobId).data.chat_match_id));
    }

    function paidChatParticipant(jobId) {
      return signedIn()
        && job(jobId).data.chat_unlocked == true
        && job(jobId).data.chat_match_id is string
        && exists(/databases/$(database)/documents/matches/$(job(jobId).data.chat_match_id))
        && selectedMatch(jobId).data.status in ['paid', 'completed']
        && (owns(job(jobId).data.client_uid) || owns(selectedMatch(jobId).data.artisan_uid));
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow write: if false;
    }

    match /artisan_profiles/{profileId} {
      // Public discovery goes through the API, which returns an explicit safe DTO.
      // This also protects legacy profiles that may still contain PII.
      allow read: if owns(profileId);
      allow write: if false;
    }

    match /artisan_private/{profileId} {
      allow read, write: if false;
    }

    match /jobs/{jobId} {
      allow read: if owns(resource.data.client_uid)
        || (signedIn()
          && resource.data.chat_match_id is string
          && exists(/databases/$(database)/documents/matches/$(resource.data.chat_match_id))
          && owns(get(/databases/$(database)/documents/matches/$(resource.data.chat_match_id)).data.artisan_uid));
      allow write: if false;

      match /messages/{messageId} {
        allow read: if paidChatParticipant(jobId);
        // Writes go through the API so the message and no-response marker are
        // committed together. This closes the message/refund race.
        allow create, update, delete: if false;
      }
    }

    match /matches/{matchId} {
      allow read: if owns(resource.data.client_uid) || owns(resource.data.artisan_uid);
      allow write: if false;
    }

    match /transactions/{transactionId} {
      allow read: if owns(resource.data.client_uid) || owns(resource.data.artisan_uid);
      allow write: if false;
    }

    match /proformas/{proformaId} {
      allow read: if owns(resource.data.artisan_uid)
        || owns(job(resource.data.job_id).data.client_uid);
      allow write: if false;
    }

    match /ratings/{ratingId} {
      allow read: if owns(resource.data.client_uid) || owns(resource.data.artisan_uid);
      allow write: if false;
    }

    match /disputes/{disputeId} {
      allow read: if owns(resource.data.raised_by_uid);
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if owns(resource.data.recipient_uid);
      allow update: if owns(resource.data.recipient_uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
